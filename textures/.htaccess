# Запрет исполнения PHP в папке с текстурами (не трогаем сами PNG)
<IfModule mod_authz_core.c>
  <FilesMatch "\.(php|phtml|php3|php4|php5|phar|inc)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(php|phtml|php3|php4|php5|phar|inc)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml
RemoveType .php .phtml
